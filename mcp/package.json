{
  "name": "@android-kit/i18n-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": { "i18n-mcp": "./dist/bin.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('../schema/i18n.v1.json', 'dist/i18n.v1.json')\"",
    "test": "npm run build && vitest run"
  },
  "dependencies": {
    "@android-kit/schema": "file:../../android-kit/packages/kit-schema",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "zod": "^3.25.0"
  },
  "engines": { "node": ">=24" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
