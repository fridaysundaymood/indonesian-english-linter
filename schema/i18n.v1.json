{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Localization lint configuration v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "domains": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["localizer"],
        "properties": {
          "localizer": {"type": "string"},
          "values": {"type": "array", "items": {"type": "string"}},
          "values_from": {"type": "string"}
        },
        "oneOf": [{"required": ["values"]}, {"required": ["values_from"]}]
      }
    },
    "ui_sinks": {"type": "array", "items": {"type": "string"}},
    "data_sinks": {"type": "array", "items": {"type": "string"}},
    "user_facing_exceptions": {"type": "array", "items": {"type": "string"}},
    "locales": {"type": "array", "items": {"type": "string"}}
  }
}
